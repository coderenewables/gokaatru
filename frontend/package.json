{
  "name": "gokaatru-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "generate:api": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts --default-non-nullable false",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/schema.d.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@tanstack/react-query": "5.107.1",
    "@xyflow/react": "^12.8.2",
    "apache-arrow": "21.2.0",
    "dockview-core": "8.9.1",
    "dockview-react": "8.9.1",
    "openapi-fetch": "0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "regl-scatterplot": "1.16.0",
    "uplot": "1.6.32",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.20.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.9"
  }
}
